# Copy to .env and fill in. .env is git/docker-ignored.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# A random secret you choose; Telegram echoes it back on every webhook call.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Claude Code OAuth token (same kind used in invoice-maker)
CLAUDE_CODE_OAUTH_TOKEN=

# Google Sheet ID (the long string in the sheet URL between /d/ and /edit)
SPREADSHEET_ID=

# Tab name to write to
SHEET_NAME=Transactions

# Comma-separated Telegram numeric chat IDs allowed to use the bot.
# Leave empty to allow anyone (not recommended). Get yours by messaging the bot
# once and checking the logs, or via @userinfobot.
ALLOWED_CHAT_IDS=

# Currency your sheet is denominated in. Bank SMS in any OTHER currency is
# written with a live GOOGLEFINANCE conversion formula to this currency, e.g.
# =16.69*GOOGLEFINANCE("CURRENCY:USDLKR").
SHEET_CURRENCY=LKR

# --- Bank-SMS ingestion (POST /ingest from an iPhone Shortcut) ---
# Shared secret the phone sends in the X-Ingest-Secret header. Generate with:
# openssl rand -hex 32. Leave empty to disable the /ingest endpoint.
# SMS confirmations go to whichever chat last messaged the bot (message it once
# after deploy), so no chat id needs to be configured here.
INGEST_SECRET=

# Model for parsing
MODEL=sonnet
