# Copy to .env and fill in. .env is git/docker-ignored.

# Token of the calorie bot from @BotFather (only used by set-webhook.sh;
# the server replies through the webhook response and never calls the Bot API).
TELEGRAM_BOT_TOKEN=

# A random secret you choose; Telegram echoes it back on every webhook call.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Claude Code OAuth token (used only for foods missing from foods.mjs / the cache)
CLAUDE_CODE_OAUTH_TOKEN=

# Comma-separated Telegram numeric chat IDs allowed to use the bot. Empty = anyone.
ALLOWED_CHAT_IDS=

# Days roll over at local midnight in this IANA time zone.
TZ_NAME=Asia/Colombo

# Google Sheet that gets one row per day (Date | Calories | Protein).
# Share it with the service account (Editor). ID = the part between /d/ and /edit.
SPREADSHEET_ID=
SHEET_NAME=daily-calories-protein-data

# Secret Cloud Scheduler sends in X-Sync-Secret when calling POST /sync nightly.
# Generate with: openssl rand -hex 32. Empty = /sync endpoint disabled.
SYNC_SECRET=

# Model for estimating unknown foods
MODEL=sonnet
